{
  "name": "el-magnate",
  "private": true,
  "type": "module",
  "description": "El Magnate: motor autoritativo, API y front",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "npm run typecheck && node scripts/sync-engine.mjs --check && node scripts/build-web.mjs --check && node --test --test-reporter=spec engine/test/*.test.ts web/test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "gen:data": "node scripts/extract-data.mjs",
    "sim": "node sim/run.ts",
    "test:balance": "node --test --test-reporter=spec sim/*.test.ts",
    "test:all": "npm test && npm run test:api && npm run test:balance",
    "sync:engine": "node scripts/sync-engine.mjs",
    "test:api": "node scripts/sync-engine.mjs --check && node --test --test-reporter=spec --test-concurrency=1 supabase/tests/*.test.ts",
    "check:anon": "node scripts/check-anon.ts",
    "db:local": "scripts/pg-local.sh start",
    "deno:check": "cd supabase/functions/api && deno check index.ts",
    "build:web": "node scripts/build-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "deno": "^2.9.6",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "hono": "^4.13.9",
    "postgres": "^3.4.9"
  }
}
